{
  "name": "universal-pdf",
  "version": "1.0.9",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Universal Simulation Ltd",
    "email": "inbox@unisim.co.uk"
  },
  "description": "Universal PDFs that just work. Free and open source PDF viewer + editor.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "build:mobile": "npm run build:desktop",
    "build:extension": "node extension/build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "credits": "node ../scripts/gen-credits.mjs . --repo https://github.com/universal-simulation-ltd/Universal_PDF --page ../../UNI_SIM_Website/public/pdf-app.html",
    "test:e2e": "node e2e/office-import.e2e.mjs",
    "test:extension": "node e2e/extension.e2e.mjs",
    "test:exit-guard": "node e2e/exit-guard.e2e.mjs",
    "test:exit-guard:desktop": "node e2e/exit-guard-desktop.e2e.mjs",
    "test:os-open:desktop": "node e2e/os-open-desktop.e2e.mjs",
    "test:tabs": "node e2e/tabs.e2e.mjs",
    "test:tabs:desktop": "node e2e/tabs-desktop.e2e.mjs",
    "test:save-folder:desktop": "node e2e/save-folder-desktop.e2e.mjs",
    "test:download-staging:desktop": "node e2e/download-staging.e2e.mjs",
    "test:handoff": "node e2e/hub-handoff.e2e.mjs",
    "test:pinch": "node e2e/pinch-zoom.e2e.mjs",
    "test:actions": "node e2e/actions-menu.e2e.mjs",
    "test:language": "node e2e/language.e2e.mjs",
    "test:separate": "node e2e/separate-placement.e2e.mjs",
    "test:qr-star": "node e2e/qr-star.e2e.mjs",
    "test:profile": "node e2e/profile-identity.e2e.mjs",
    "test:greeting": "node e2e/phone-greeting.e2e.mjs",
    "test:privacy": "node e2e/privacy-note.e2e.mjs",
    "test:flatten": "node e2e/flatten-export.e2e.mjs",
    "test:about": "node e2e/about-app.e2e.mjs",
    "test:page-scroll": "node e2e/page-scroll.e2e.mjs",
    "test:placement-hint": "node e2e/placement-hint.e2e.mjs",
    "test:external-links:e2e": "node e2e/external-links.e2e.mjs",
    "test:panel-dodge": "node e2e/panel-dodge.e2e.mjs",
    "test:open-fit": "node e2e/open-at-fit.e2e.mjs",
    "test:crisp": "node e2e/crisp-pages.e2e.mjs",
    "test:progressive-load": "node e2e/progressive-load.e2e.mjs",
    "test:font-data": "node e2e/font-data.e2e.mjs",
    "test:text-link-entry": "node e2e/text-link-entry.e2e.mjs",
    "test:lock": "node e2e/lock-pdf.e2e.mjs",
    "test:preview": "node e2e/export-preview.e2e.mjs",
    "test:redact-hint": "node e2e/redact-hint-follow.e2e.mjs",
    "test:word-dblclick": "node e2e/word-dblclick.e2e.mjs",
    "test:link-click": "node e2e/link-click.e2e.mjs",
    "test:line-tap": "node e2e/line-tap.e2e.mjs",
    "test:shape-tap": "node e2e/shape-tap.e2e.mjs",
    "test:select-area": "node e2e/select-area-touch.e2e.mjs",
    "test:text-resize": "node e2e/text-box-resize.e2e.mjs",
    "test:export-fidelity": "node e2e/export-fidelity.e2e.mjs",
    "test:locked-recents": "node e2e/locked-recents.e2e.mjs",
    "test:lock-password": "node --experimental-strip-types scripts/lockPassword.test.mjs",
    "test:sign-access": "node --experimental-strip-types scripts/signAccessSecret.test.mjs",
    "test:encrypt": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/pdfEncrypt.test.mjs",
    "test:names": "node --experimental-strip-types scripts/exportName.test.mjs",
    "test:hosted-paths": "node --experimental-strip-types scripts/hostedPath.test.mjs",
    "test:heic-sniff": "node --experimental-strip-types scripts/heicSniff.test.mjs",
    "test:jpeg-orientation": "node --experimental-strip-types scripts/jpegOrientation.test.mjs",
    "test:status-bar": "node --experimental-strip-types scripts/statusBarGlyphs.test.mjs",
    "test:external-links": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/externalLinks.test.mjs",
    "test:build-env": "node --experimental-strip-types scripts/buildEnv.test.mjs",
    "test:render-queue": "node --experimental-strip-types scripts/renderQueue.test.mjs",
    "test:tap-placement": "node --experimental-strip-types scripts/tapPlacement.test.mjs",
    "test:scan-geometry": "node --experimental-strip-types scripts/scanGeometry.test.mjs",
    "test:scan-detect": "node --experimental-strip-types scripts/scanDetect.test.mjs",
    "test:photo-scan": "node e2e/photo-scan.e2e.mjs",
    "test:link-underline": "node --experimental-strip-types scripts/linkUnderline.test.mjs",
    "test:user-link": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/userLink.test.mjs",
    "test:link-safety": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/linkSafety.test.mjs",
    "test:link-style": "node e2e/link-style.e2e.mjs",
    "test:ocr-languages": "node e2e/ocr-languages.e2e.mjs",
    "test:compare": "node --experimental-strip-types scripts/compare.test.mjs",
    "test:compare:e2e": "node e2e/compare.e2e.mjs",
    "test:lazy-pdf-lib": "node e2e/lazy-pdf-lib.e2e.mjs",
    "test:offline-sign": "node e2e/offline-sign.e2e.mjs",
    "test:csp": "node e2e/csp.e2e.mjs",
    "test:ocr-langs": "node --experimental-strip-types scripts/ocrLanguages.test.mjs",
    "check:mobile-bundle": "node scripts/verify-mobile-bundle.mjs",
    "check:ios-launch": "node scripts/verify-ios-launch.mjs",
    "electron": "electron .",
    "thumbnail:build": "powershell -NoProfile -ExecutionPolicy Bypass -File native/win-thumbnail/scripts/build.ps1",
    "dist": "npm run build:desktop && electron-builder",
    "dist:win": "npm run build:desktop && electron-builder --win",
    "dist:mac": "npm run build:desktop && scripts/with-python.sh electron-builder --mac",
    "dist:mac:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false npm run build:desktop && CSC_IDENTITY_AUTO_DISCOVERY=false scripts/with-python.sh electron-builder --mac -c.mac.notarize=false -c.mac.hardenedRuntime=false",
    "dist:linux": "npm run build:desktop && electron-builder --linux",
    "cap:sync": "npm run build:mobile && npx cap sync && npm run check:mobile-bundle && npm run check:ios-launch",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "test:redact-covers": "node e2e/redact-covers-match.e2e.mjs",
    "test:image-border": "node e2e/image-border.e2e.mjs",
    "test:reset-defaults": "node e2e/reset-defaults.e2e.mjs",
    "test:place-ghost": "node e2e/place-ghost.e2e.mjs",
    "test:scrub-export": "node e2e/scrub-export.e2e.mjs",
    "test:merge-guard": "node e2e/merge-guard.e2e.mjs",
    "test:cross-page-drag": "node e2e/cross-page-drag.e2e.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@unisim/doc": "^0.7.0",
    "@unisim/media": "^0.7.0",
    "@unisim/qr": "^0.1.0",
    "@unisim/sdk": "^0.180.8",
    "heic-to": "^1.5.2",
    "konva": "^9.3.20",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qr-code-styling": "^1.9.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "tesseract.js": "^5.1.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  },
  "build": {
    "appId": "uk.co.unisim.pdf",
    "productName": "Universal PDF",
    "electronLanguages": [
      "en-US",
      "en-GB",
      "de",
      "es",
      "es-419",
      "fr",
      "it",
      "pt-BR",
      "pt-PT",
      "tr"
    ],
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*",
      "node_modules/@unisim/sdk/package.json",
      "node_modules/@unisim/sdk/electron/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "UniversalPDF.Document",
        "description": "PDF Document",
        "role": "Editor",
        "mimeType": "application/pdf",
        "icon": "build/document-icon.ico"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/app-icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "artifactName": "Universal-PDF-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/app-icon.png",
      "category": "Office",
      "synopsis": "Free and open-source PDF viewer and editor",
      "desktop": {
        "entry": {
          "MimeType": "application/pdf;"
        }
      },
      "artifactName": "Universal-PDF-${version}-linux-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/app-icon.png",
      "extraResources": [
        {
          "from": "native/win-thumbnail/dist",
          "to": ".",
          "filter": [
            "UniversalPdfThumb.dll",
            "pdfium.dll",
            "PDFIUM-LICENSE.txt"
          ]
        }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/installer-icon.ico",
      "uninstallerIcon": "build/installer-icon.ico",
      "artifactName": "Universal-PDF-Setup-${version}.${ext}"
    }
  }
}
