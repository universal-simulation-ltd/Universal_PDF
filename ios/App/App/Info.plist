<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>fr</string>
		<string>es</string>
		<string>it</string>
		<string>de</string>
		<string>pt-BR</string>
		<string>pt-PT</string>
		<string>tr</string>
	</array>
	<key>CFBundleDisplayName</key>
        <string>Universal PDF</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- ⚠️ THE APP DOES NOT LAUNCH WITHOUT THIS. iOS terminates an app built
	     against the current SDK that still uses the old app-delegate window
	     life cycle, before any of our code runs — "UIScene life cycle is
	     required for apps built with this SDK" in the device log and nothing
	     on screen. That is the crash App Review hit on 1.0.3.

	     The manifest is only half of it: the runtime also checks that the app
	     delegate answers application(_:configurationForConnecting:options:).
	     Both halves, plus SceneDelegate.swift itself, are checked by
	     `npm run check:ios-launch`.

	     Capacitor adopted scenes in 8.5 and this app is on 7, so the three
	     pieces are written out by hand rather than coming from the template.
	     UISceneStoryboardFile keeps Main.storyboard (a bare
	     CAPBridgeViewController) as the scene's storyboard, exactly as
	     UIMainStoryboardFile did before. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- ⚠️ A MISSING USAGE STRING IS A CRASH, not a refusal: iOS terminates
	     the process the moment a privacy-gated resource is reached without
	     one (see Docs_UNI_SIM/landmines.md — it took Universal Family's iOS
	     app down on the first tap of the microphone).

	     Nothing here calls the camera directly. The web layer's image pickers
	     do, by proxy: an <input type="file"> that accepts images makes the
	     WebView offer "Take Photo" alongside the photo library, and tapping it
	     opens the camera with our bundle's usage string. Add a picture to a
	     page, import a signature, convert an image to PDF — all three reach
	     it. `npm run check:ios-launch` fails if such an input exists in src/
	     and this key does not.

	     Video is deliberately NOT accepted anywhere, so there is no
	     NSMicrophoneUsageDescription: iOS only offers "Take Video" (and only
	     then asks for the microphone) when the input accepts a video type. -->
	<key>NSCameraUsageDescription</key>
	<string>Take a photo to add to your PDF — a picture, a signature or a page to convert. Photos stay on this device.</string>
	<!-- Puts Universal PDF in the Files app's "Open With" menu and the share
	     sheet for PDFs. iOS 26 DOES have a default app per file type — the Open
	     With menu marks one "Default" — so registering here is what makes the
	     app both listed and selectable as that default. It cannot be set
	     programmatically; the user picks.

	     ⚠️ LSSupportsOpeningDocumentsInPlace was previously omitted on purpose,
	     to be handed a plain file:// copy in the app's Inbox rather than a
	     security-scoped URL. The reasoning was sound but the price was too
	     high: the Files "Open With" list is built from handlers that can open a
	     document IN PLACE, so without this key the app was absent from the list
	     entirely — verified on an iPhone 15 Pro, where Adobe Scan, Fusion and
	     OpenDocument-Reader Lite were all listed and this app was not.

	     The plain-path guarantee is kept instead of dropped: AppDelegate copies
	     an in-place document into the app's own container and forwards the
	     COPY, so the web layer still only ever sees a readable file:// path it
	     does not have to manage access for. See application(_:open:options:). -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PDF Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- BEGIN unisim suite app links — generated by scripts/add-suite-app-links.mjs, do not hand-edit -->
	<!-- This app's own scheme. Another suite app opens it with
	     unisim-pdf:// — see UnisimSuiteAuthPlugin.openApp. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>uk.co.unisim.pdf</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>unisim-pdf</string>
			</array>
		</dict>
	</array>
	<!-- Every suite scheme this app may ask about. ⚠️ canOpenURL answers FALSE
	     for anything not listed here and says so only in the device console —
	     which the switcher cannot tell apart from "not installed". The full
	     list is written into every app deliberately: identical blocks make a
	     stale one visible. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>unisim-ergo-assess</string>
		<string>unisim-cyber-assess</string>
		<string>unisim-workplace-assess</string>
		<string>unisim-fire-assess</string>
		<string>unisim-coshh-assess</string>
		<string>unisim-risk-assess</string>
		<string>unisim-pdf</string>
		<string>unisim-images</string>
		<string>unisim-qr</string>
		<string>unisim-compress</string>
		<string>unisim-converter</string>
		<string>unisim-polling</string>
		<string>unisim-blackbook</string>
		<string>unisim-ai</string>
		<string>unisim-jukebox</string>
	</array>
	<!-- END unisim suite app links -->
</dict>
</plist>
