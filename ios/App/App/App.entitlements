<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The shared suite Keychain group. The phone app has had no sign-in since
	     2026-10-12, but this group STAYS, because the Face ID signature vault
	     lives in it: SignatureVault.swift sets no kSecAttrAccessGroup, and an
	     item added without one goes into the FIRST group listed here. Removing
	     the group would leave every existing vault key unreadable, and with it
	     the signatures it seals. To drop it, first move the vault into the
	     app's own group (read from here, rewrite with an explicit group) and
	     ship that, then remove this.
	     @unisim/sdk's UnisimSuiteAuth plugin reads the suite session from the
	     same group; the team prefix is expanded by Xcode here and resolved at
	     runtime by the plugin.
	     Sign in with Apple's entitlement (com.apple.developer.applesignin) was
	     removed on 2026-10-12 with the sign-in; the App ID's capability can go
	     too, but leaving it on does no harm. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)co.uk.unisim.suite</string>
	</array>
</dict>
</plist>
