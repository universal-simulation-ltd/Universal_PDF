<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Apple's privacy manifest, required for App Store submission.

  Opening, reading, marking up and signing a PDF happens on the phone and sends
  nothing (PRIVACY.md). What CAN leave, and only when the user asks for it:

  - Signing in with a Universal ID: the email and the account id.
  - "Send to sign": the PDF itself and the signer's email address. It is a
    button the user presses. (The "Store with UNI·SIM" online backup was
    retired on 2026-10-03; Back up is local only.)
  - While signed in, one "the app was opened" event per launch, tied to the
    account (the SDK's <UsageTracker />). Nothing about the file. Declared as
    product interaction, for analytics, because that is what it is.

  No suite user count from the phone app (2026-10-12): the SDK's presence
  heartbeat (the random install id, every 45 s) is switched off in the
  iOS/Android shell (src/main.tsx `presence: !isDesktop && !isNativeShell()`), because the
  App Store and Play figures already count installs. So no Device ID is
  collected. Only the website sends it (the desktop app and the browser
  extension don't either), and the website is not covered by this manifest.

  The iOS Scan button is Apple's VisionKit (DocumentScanner.swift), which
  sends nothing, so the ML Kit diagnostics declared in Play's Data safety
  answers (store-assets/data-safety.json) do not apply here.

  All of it goes to our own servers. Nothing is used for tracking, and there
  are no third-party analytics or advertising SDKs.

  Required-reason APIs: @capacitor/filesystem reads file creation and
  modification dates (its `stat`), only on files in the app's own container,
  and it ships no manifest of its own. Capacitor's core frameworks carry their
  own manifests for what they use, so they are not repeated here.

  Keep this in step with the App Store Connect privacy answers and PRIVACY.md.
-->
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- @capacitor/filesystem's stat: files in the app container. C617.1. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!-- The sign-in email, and a signer's email for Send to sign. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- A PDF the user chooses to store online or send to sign. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- One "session.opened" event per launch, only while signed in
			     (<UsageTracker />). Goes when the phone app drops sign-in. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
