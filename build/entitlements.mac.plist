<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened Runtime entitlements for a notarised macOS build.

  IN USE by the release pipeline: `dist:mac` signs with the Developer ID cert
  (Universal Simulation Ltd, ZH9C5TS86A) and notarises, and Hardened Runtime is
  REQUIRED for notarisation — it blocks things Electron genuinely needs, which
  is what the keys below hand back. Only `dist:mac:unsigned` turns both off, for
  a local build with no cert to hand.

  Deliberately SHORTER than Universal USB's copy of this file: that app loads an
  unsigned libusb .node and needs `disable-library-validation` to do it.
  Universal PDF is pure JavaScript — pdf-lib, pdf.js and tesseract.js are all
  WASM or JS, with no native binding to validate — so that exception is not
  here. Don't paste it back in without a reason.
-->
<plist version="1.0">
<dict>
  <!-- Electron's V8 JIT. Without these the renderer crashes on launch. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Electron sets DYLD_* variables for its own framework loading. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
