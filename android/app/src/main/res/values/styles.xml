<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- ⚠️ The last three items are the fallback half of Capacitor 8's
         SystemBars handling (capacitor.config.ts). On a WebView older than
         Chromium 140 SystemBars pads the web view out from under the status
         bar and the camera cutout instead of drawing edge-to-edge, and those
         strips show the WINDOW background. DayNight takes that background and
         the status-bar icon colour from the SYSTEM theme, so a phone in dark
         mode would get a near-black strip with white icons above the white
         navbar. Universal PDF has no dark colourway, so its Android chrome is
         pinned light. (Until Capacitor 8 this was the other half of
         `android.adjustMarginsForEdgeToEdge: 'auto'`, which 8 removed.) -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/unisimWindowBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>