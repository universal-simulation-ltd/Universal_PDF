#include <winver.h>
#include "resource.h"

// The badge art is the file-association icon itself, so the thumbnail's corner
// and the flat icon Explorer falls back to are the same mark.
IDR_BADGE_ICO RCDATA "@BADGE_ICO_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @UNIPDF_VERSION_COMMA@
PRODUCTVERSION @UNIPDF_VERSION_COMMA@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904b0"
    BEGIN
      VALUE "CompanyName", "Universal Simulation Ltd"
      VALUE "FileDescription", "Universal PDF Thumbnail Provider"
      VALUE "FileVersion", "@UNIPDF_VERSION@"
      VALUE "InternalName", "UniversalPdfThumb"
      VALUE "LegalCopyright", "Universal Simulation Ltd"
      VALUE "OriginalFilename", "UniversalPdfThumb.dll"
      VALUE "ProductName", "Universal PDF"
      VALUE "ProductVersion", "@UNIPDF_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x809, 1200
  END
END
